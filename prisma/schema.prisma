// Anju Diam Co., Ltd. — data model
//
// Covers the MVP scope in the PRD: ~250 product catalogue, search and filters,
// wishlist, cart, customer accounts, enquiry-based orders, and lead capture.
//
// PORTABILITY NOTE
// Postgres, because the site is deployed to Vercel, whose filesystem resets on
// every deploy — a SQLite file there would lose every order and enquiry. The
// models below were written portable from the start, so the switch needed no
// model edits at all:
//
//   * no native enums      — the union types live in src/lib/enums.ts and are
//                            enforced by Zod at every write path, which also
//                            keeps SQLite viable for local work
//   * no scalar lists      — images are a related ProductImage table, which is
//                            better modelling anyway (ordering, alt text)
//   * no @db.* attributes  — Prisma already maps String to TEXT on Postgres
//
// Local development points DATABASE_URL at the same Postgres (a free Neon
// branch is fine). To go back to SQLite, set provider to "sqlite" and point
// DATABASE_URL at a file: URL — no model edits either way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  /// The house's own tag number, as written on the physical label and in the
  /// stock sheet. Nullable because the placeholder catalogue predates it, and
  /// unique so a re-import updates the piece rather than duplicating it —
  /// Postgres allows many NULLs in a unique index, so untagged rows coexist.
  sku String? @unique

  /// One of RINGS | EARRINGS | NECKLACES | BRACELETS | GIFTING
  category String
  /// One of DRAFT | ACTIVE | ARCHIVED
  status   String @default("ACTIVE")

  /// Held in the smallest currency unit (satang) to avoid float drift.
  priceMinor Int
  currency   String @default("THB")

  /// When true the storefront shows no figure for this piece and asks the
  /// customer to write in instead. The house negotiates at this end of the
  /// market, and publishing a number would misrepresent how it actually sells.
  /// `priceMinor` may still hold an internal figure — it is simply never shown,
  /// never sorted on, and never totalled in a selection.
  priceOnEnquiry Boolean @default(false)

  // ── Physical specification: the PRD's required product data ──────────────
  grossWeightG Float
  /// One of YELLOW_GOLD_18K | WHITE_GOLD_18K | ROSE_GOLD_18K
  metal        String @default("YELLOW_GOLD_18K")
  metalPurity  String @default("18K")

  // ── Gemstone specification ───────────────────────────────────────────────
  // House standard is G colour or better, VS clarity or better. Enforced in
  // the seed, in the catalogue importer, and in admin validation.
  diamondCount   Int
  diamondCaratW  Float
  diamondColour  String  @default("G")
  diamondClarity String  @default("VS")
  /// Primary stone silhouette, drives the placeholder artwork.
  /// ROUND | OVAL | PEAR | EMERALD | MARQUISE | PRINCESS | CUSHION
  stoneShape     String  @default("ROUND")
  illusionSet    Boolean @default(false)

  videoUrl   String?
  isFeatured Boolean @default(false)
  /// Ordering weight for merchandised grids; lower sorts first.
  rank       Int     @default(500)

  // ── Availability ─────────────────────────────────────────────────────────
  // The house works made-to-order, so that is the default and such a piece is
  // always orderable. Set madeToOrder false to have the storefront respect a
  // real count. When variants exist the count lives on each variant instead
  // and these two fields are ignored — see src/lib/stock.ts, which is the one
  // place that decides.
  madeToOrder Boolean @default(true)
  stock       Int     @default(0)
  /// What the variants vary by, shown as the selector label, e.g. "Ring size".
  /// Null on a one-of-one piece, which then has no variants at all.
  variantAxis String?
  /// The studio's one-click "this piece has been sold" switch. It beats every
  /// rule above: a sold piece stays on the storefront, labelled Sold out, and
  /// cannot be added to a selection — whether it is made to order or counted.
  soldOut     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  certificates  Certificate[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([category, status])
  @@index([isFeatured])
  @@index([priceMinor])
}

/// Real photography, once the client supplies it. A product with no rows here
/// falls back to the generated placeholder artwork — see src/lib/product-art.tsx.
model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String @default("")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// A buyable option of a piece — a ring size, a chain length, a metal colour.
/// Single-axis on purpose: the axis is named on the product (`variantAxis`),
/// and a full size x metal matrix is not something this catalogue needs. A
/// piece with no rows here is one-of-one and sells on the product row alone.
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  /// Shown verbatim in the selector, e.g. "US 6" or "42 cm".
  label     String
  /// The house's own reference for this exact option.
  sku       String?
  /// Overrides the product price when set. Null means "same as the piece",
  /// which is the common case — most sizes cost the same.
  priceMinor Int?
  /// On-hand units. Ignored while the parent piece is made-to-order.
  stock     Int    @default(0)
  position  Int    @default(0)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, label])
  @@index([productId, position])
}

/// Grading report for a piece. Separate rows rather than columns on Product
/// because a multi-stone piece can carry several, and because the scan is an
/// uploaded file that wants its own lifecycle.
model Certificate {
  id        String @id @default(cuid())
  productId String
  /// One of GIA | IGI | HRD | AGS | GII | OTHER
  lab       String @default("GIA")
  /// The report number as printed. Not unique: a re-issued report legitimately
  /// repeats, and rejecting that at the database would block a real import.
  number    String
  /// Uploaded PDF or scan, served by /api/media like product photography.
  documentUrl String?

  // Optional because a report is often filed before it is fully transcribed.
  caratW   Float?
  colour   String?
  clarity  String?
  cut      String?
  issuedOn DateTime?

  position Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  /// One of CUSTOMER | ADMIN
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())

  orders Order[]
}

/// Cart and wishlist are keyed by an opaque owner string rather than a user
/// FK, so a visitor can build a selection before creating an account. The key
/// is "u:<userId>" once signed in and "g:<guestId>" before that, where guestId
/// is an httpOnly cookie. Signing in merges the guest rows across — see
/// src/lib/owner.ts.
model Cart {
  id     String  @id @default(cuid())
  key    String  @unique
  userId String?

  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  /// Which option was chosen. Null on a one-of-one piece. SetNull rather than
  /// Cascade: withdrawing a size should not silently empty someone's selection,
  /// it should leave the line for the studio to resolve.
  variantId String?
  quantity  Int     @default(1)
  /// Free-text personalisation, e.g. "size 14, rose gold instead".
  note      String?

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Two sizes of one ring are two lines. SQL treats NULLs as distinct, so this
  // does not constrain the no-variant case — src/lib/cart.ts matches on both
  // columns before inserting, which is what actually prevents a duplicate.
  @@unique([cartId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  key       String
  userId    String?
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([key, productId])
  @@index([key])
}

/// An order here is a confirmed enquiry, not a card charge. At this price point
/// the house confirms stone availability and final sizing before taking payment,
/// so the customer-facing flow ends at "we will be in touch", and the record
/// carries everything the atelier needs to quote.
model Order {
  id        String  @id @default(cuid())
  /// Human-facing, e.g. AD-2026-0412.
  reference String  @unique
  userId    String?
  /// One of PENDING | CONFIRMED | IN_PRODUCTION | SHIPPED | DELIVERED | CANCELLED
  status    String  @default("PENDING")

  totalMinor Int
  currency   String @default("THB")

  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingLine1   String
  shippingCity    String
  shippingPost    String
  shippingCountry String
  message         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  /// Snapshotted so historic orders survive a price change.
  unitPriceMinor Int
  /// Snapshotted for the same reason, and so the line still reads "US 6" after
  /// that size is withdrawn. No FK: the label is the record, not a pointer.
  variantLabel   String?
  note           String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Enquiry {
  id       String  @id @default(cuid())
  name     String
  email    String
  phone    String?
  /// One of CONTACT | CUSTOM | PRODUCT
  kind     String  @default("CONTACT")
  /// Category of interest, or the slug of the piece being enquired about.
  subject  String?
  message  String
  budget   String?
  /// One of NEW | IN_PROGRESS | ANSWERED | CLOSED
  status   String  @default("NEW")
  source   String  @default("website")
  /// Whether the outbound alert to the house inbox was delivered.
  notified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
