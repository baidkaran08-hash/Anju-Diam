// Anju Diam Co., Ltd. — data model
//
// Covers the MVP scope in the PRD: ~250 product catalogue, search and filters,
// wishlist, cart, customer accounts, enquiry-based orders, and lead capture.
//
// PORTABILITY NOTE
// The datasource below is SQLite so the site runs the moment it is cloned, with
// no database to provision. Everything here is deliberately written to survive
// a switch to Postgres unchanged:
//
//   * no native enums      — Prisma enums are unsupported on SQLite, so the
//                            union types live in src/lib/enums.ts and are
//                            enforced by Zod at every write path
//   * no scalar lists      — images are a related ProductImage table, which is
//                            better modelling anyway (ordering, alt text)
//   * no @db.* attributes  — Prisma already maps String to TEXT on Postgres
//
// To move to Postgres: change provider to "postgresql", point DATABASE_URL at
// the new instance, and run `npm run db:push && npm run db:seed`. No model
// edits required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  /// One of RINGS | EARRINGS | NECKLACES | BRACELETS | GIFTING
  category String
  /// One of DRAFT | ACTIVE | ARCHIVED
  status   String @default("ACTIVE")

  /// Held in the smallest currency unit (satang) to avoid float drift.
  priceMinor Int
  currency   String @default("THB")

  // ── Physical specification: the PRD's required product data ──────────────
  grossWeightG Float
  /// One of YELLOW_GOLD_18K | WHITE_GOLD_18K | ROSE_GOLD_18K
  metal        String @default("YELLOW_GOLD_18K")
  metalPurity  String @default("18K")

  // ── Gemstone specification ───────────────────────────────────────────────
  // House standard is G colour or better, VS clarity or better. Enforced in
  // the seed, in the catalogue importer, and in admin validation.
  diamondCount   Int
  diamondCaratW  Float
  diamondColour  String  @default("G")
  diamondClarity String  @default("VS")
  /// Primary stone silhouette, drives the placeholder artwork.
  /// ROUND | OVAL | PEAR | EMERALD | MARQUISE | PRINCESS | CUSHION
  stoneShape     String  @default("ROUND")
  illusionSet    Boolean @default(false)

  videoUrl   String?
  isFeatured Boolean @default(false)
  /// Ordering weight for merchandised grids; lower sorts first.
  rank       Int     @default(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([category, status])
  @@index([isFeatured])
  @@index([priceMinor])
}

/// Real photography, once the client supplies it. A product with no rows here
/// falls back to the generated placeholder artwork — see src/lib/product-art.tsx.
model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String @default("")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  /// One of CUSTOMER | ADMIN
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())

  orders Order[]
}

/// Cart and wishlist are keyed by an opaque owner string rather than a user
/// FK, so a visitor can build a selection before creating an account. The key
/// is "u:<userId>" once signed in and "g:<guestId>" before that, where guestId
/// is an httpOnly cookie. Signing in merges the guest rows across — see
/// src/lib/owner.ts.
model Cart {
  id     String  @id @default(cuid())
  key    String  @unique
  userId String?

  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  /// Free-text personalisation, e.g. "size 14, rose gold instead".
  note      String?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  key       String
  userId    String?
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([key, productId])
  @@index([key])
}

/// An order here is a confirmed enquiry, not a card charge. At this price point
/// the house confirms stone availability and final sizing before taking payment,
/// so the customer-facing flow ends at "we will be in touch", and the record
/// carries everything the atelier needs to quote.
model Order {
  id        String  @id @default(cuid())
  /// Human-facing, e.g. AD-2026-0412.
  reference String  @unique
  userId    String?
  /// One of PENDING | CONFIRMED | IN_PRODUCTION | SHIPPED | DELIVERED | CANCELLED
  status    String  @default("PENDING")

  totalMinor Int
  currency   String @default("THB")

  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingLine1   String
  shippingCity    String
  shippingPost    String
  shippingCountry String
  message         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  /// Snapshotted so historic orders survive a price change.
  unitPriceMinor Int
  note           String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Enquiry {
  id       String  @id @default(cuid())
  name     String
  email    String
  phone    String?
  /// One of CONTACT | CUSTOM | PRODUCT
  kind     String  @default("CONTACT")
  /// Category of interest, or the slug of the piece being enquired about.
  subject  String?
  message  String
  budget   String?
  /// One of NEW | IN_PROGRESS | ANSWERED | CLOSED
  status   String  @default("NEW")
  source   String  @default("website")
  /// Whether the outbound alert to the house inbox was delivered.
  notified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
