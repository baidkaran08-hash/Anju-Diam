// Anju Diam Co., Ltd. — data model
// Covers the MVP scope in the PRD: ~250 product catalogue, search and filters,
// wishlist, cart, customer accounts, orders, and enquiry capture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  RINGS
  EARRINGS
  NECKLACES
  BRACELETS
  BRIDAL
}

enum Metal {
  YELLOW_GOLD_18K
  WHITE_GOLD_18K
  ROSE_GOLD_18K
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Role {
  CUSTOMER
  ADMIN
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @db.Text
  category    Category
  status      ProductStatus @default(ACTIVE)

  // Pricing is held in the smallest currency unit to avoid float drift.
  priceMinor Int
  currency   String @default("THB")

  // Physical specification — the PRD's required product data.
  grossWeightG Float
  metal        Metal  @default(YELLOW_GOLD_18K)
  metalPurity  String @default("18K")

  // Gemstone specification. The house standard is G colour or better,
  // VS clarity or better — enforced in the seed and in admin validation.
  diamondCount  Int
  diamondCaratW Float
  diamondColour String @default("G")
  diamondClarity String @default("VS")
  illusionSet   Boolean @default(false)

  images     String[]
  videoUrl   String?
  isFeatured Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([category, status])
  @@index([isFeatured])
  @@index([priceMinor])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  cart     Cart?
  wishlist WishlistItem[]
  orders   Order[]
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  note      String? // e.g. "size 14, rose gold instead"

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique // human-facing, e.g. AD-2026-0412
  userId      String?
  status      OrderStatus @default(PENDING)
  totalMinor  Int
  currency    String      @default("THB")

  customerName  String
  customerEmail String
  customerPhone String?
  shippingLine1 String
  shippingCity  String
  shippingPost  String
  shippingCountry String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  // Price is snapshotted so historic orders survive a price change.
  unitPriceMinor Int
  note           String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  category  String?
  message   String        @db.Text
  status    EnquiryStatus @default(NEW)
  source    String        @default("website")
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}
