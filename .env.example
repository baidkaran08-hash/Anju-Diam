# ── Database ────────────────────────────────────────────────────────────────
# Postgres, because the site deploys to Vercel and its filesystem resets on
# every deploy. Use the SAME connection string locally as in production, or a
# separate free Neon branch if you would rather not touch live data.
#
# Neon gives you this string on signup; it looks like:
#   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# ── Site ────────────────────────────────────────────────────────────────────
# In production: https://www.anjudiam.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Floating WhatsApp button. Digits only, with country code, no plus.
# Set to the house mobile (+66 83 163 6736). Leave blank to hide the button
# entirely if that line does not actually take WhatsApp.
NEXT_PUBLIC_WHATSAPP="66831636736"

# ── Uploaded media ──────────────────────────────────────────────────────────
# On Vercel: leave MEDIA_DIR unset. Add Blob storage in the dashboard and
# Vercel injects BLOB_READ_WRITE_TOKEN, which switches uploads to Blob
# automatically. Nothing else to configure.
#
# On a host with a real disk: leave the token unset and point MEDIA_DIR at
# persistent storage. Files are then served by /api/media.
# MEDIA_DIR="./media"

# ── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST unset and every send is logged to the console instead —
# the enquiry flow still works end to end, it just does not notify anyone.
#
# For Gmail you need an App Password, not the account password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="info@anjudiam.com"
# SMTP_PASS="your-16-character-app-password"
# ENQUIRY_INBOX="info@anjudiam.com"

# ── Seed (optional) ─────────────────────────────────────────────────────────
# Override before seeding a production database.
# SEED_ADMIN_EMAIL="admin@anjudiam.com"
# SEED_ADMIN_PASSWORD="something-long-and-random"
