# ── Database ────────────────────────────────────────────────────────────────
# SQLite by default so the site runs with no database to provision.
# For production, switch the provider in prisma/schema.prisma to "postgresql"
# and point this at Neon, Supabase or Railway.
DATABASE_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# ── Site ────────────────────────────────────────────────────────────────────
# In production: https://www.anjudiam.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Floating WhatsApp button. Digits only, with country code, no plus.
# Set to the house mobile (+66 83 163 6736). Leave blank to hide the button
# entirely if that line does not actually take WhatsApp.
NEXT_PUBLIC_WHATSAPP="66831636736"

# ── Uploaded media ──────────────────────────────────────────────────────────
# Where product photographs are written. Served by /api/media, deliberately not
# from public/ (Next only serves files that existed at build time).
# On an ephemeral filesystem, point this at a mounted volume.
# MEDIA_DIR="./media"

# ── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST unset and every send is logged to the console instead —
# the enquiry flow still works end to end, it just does not notify anyone.
#
# For Gmail you need an App Password, not the account password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="info@anjudiam.com"
# SMTP_PASS="your-16-character-app-password"
# ENQUIRY_INBOX="info@anjudiam.com"

# ── Seed (optional) ─────────────────────────────────────────────────────────
# Override before seeding a production database.
# SEED_ADMIN_EMAIL="admin@anjudiam.com"
# SEED_ADMIN_PASSWORD="something-long-and-random"
