# ── Database ────────────────────────────────────────────────────────────────
# Postgres, because the site deploys to Vercel and its filesystem resets on
# every deploy. Use the SAME connection string locally as in production, or a
# separate free Neon branch if you would rather not touch live data.
#
# SUPABASE (this project's database)
# The project reference is deliberately not written down here — this file is
# committed, the repository is public, and a reference plus a leaked anon key
# is enough to reach a database whose row-level security is off. Take the
# string from the dashboard instead: Connect -> ORMs -> Prisma, or
# Project Settings -> Database.
#
# Use the DIRECT connection on port 5432, not the transaction pooler on 6543:
# `prisma db push` runs at boot from scripts/prepare-production.ts and needs a
# session it can issue DDL on, which the transaction pooler will not give it.
#
#   postgresql://postgres:PASSWORD@db.<your-ref>.supabase.co:5432/postgres
#
# If traffic ever outgrows a direct connection, move DATABASE_URL to the pooler
# and add a separate directUrl to prisma/schema.prisma for the DDL path.
#
# Neon works equally well; it gives you a string on signup that looks like:
#   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# ── Site ────────────────────────────────────────────────────────────────────
# In production: https://www.anjudiam.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Floating WhatsApp button. Digits only, with country code, no plus.
# Set to the house mobile (+66 83 163 6736). Leave blank to hide the button
# entirely if that line does not actually take WhatsApp.
NEXT_PUBLIC_WHATSAPP="66831636736"

# ── Uploaded media ──────────────────────────────────────────────────────────
# On Vercel: leave MEDIA_DIR unset. Add Blob storage in the dashboard and
# Vercel injects BLOB_READ_WRITE_TOKEN, which switches uploads to Blob
# automatically. Nothing else to configure.
#
# On a host with a real disk: leave the token unset and point MEDIA_DIR at
# persistent storage. Files are then served by /api/media.
# MEDIA_DIR="./media"
#
# S3-COMPATIBLE STORAGE (recommended once the site is deployed)
# Works with Cloudflare R2, Backblaze B2, Wasabi, MinIO or AWS. Setting these
# takes precedence over everything above.
#
# R2 is the most generous free tier: 10 GB stored and no charge for serving it,
# which at roughly half a megabyte per processed photograph is about twenty
# thousand of them. The whole Anju Diam catalogue is under 100 MB.
#
# From the Cloudflare dashboard: R2 -> Create bucket, then Manage R2 API Tokens
# for the key pair. S3_PUBLIC_URL is the bucket's public r2.dev address or your
# own domain bound to it — without it the stored URLs point at an endpoint that
# answers 403 to a customer's browser.
#
# S3_BUCKET="anju-diam-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_PUBLIC_URL="https://media.anjudiam.com"

# ── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST unset and every send is logged to the console instead —
# the enquiry flow still works end to end, it just does not notify anyone.
#
# For Gmail you need an App Password, not the account password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="info@anjudiam.com"
# SMTP_PASS="your-16-character-app-password"
# ENQUIRY_INBOX="info@anjudiam.com"

# ── Studio account ──────────────────────────────────────────────────────────
# Read by `npm run admin:create`, which makes exactly one administrator and
# nothing else. Do not use `npm run db:seed` on a live database: it also
# inserts a demo customer whose password is published in the README.
#
#   read -rs "PW?Password: " && ADMIN_PASSWORD="$PW" ADMIN_EMAIL="info@anjudiam.com" \
#     npm run admin:create && unset PW

# ── Seed (optional) ─────────────────────────────────────────────────────────
# Override before seeding a production database.
# SEED_ADMIN_EMAIL="admin@anjudiam.com"
# SEED_ADMIN_PASSWORD="something-long-and-random"
