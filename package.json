{
  "name": "anju-diam",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "catalogue:import": "tsx scripts/import-catalogue.ts",
    "frames:build": "tsx scripts/build-frames.ts",
    "logo:build": "tsx scripts/build-logo.ts",
    "start:prod": "tsx scripts/prepare-production.ts && next start -p ${PORT:-3000}",
    "db:backup": "tsx scripts/backup-db.ts",
    "vercel-build": "tsx scripts/set-db-provider.ts postgresql && prisma generate && tsx scripts/prepare-production.ts && next build",
    "db:local": "tsx scripts/set-db-provider.ts sqlite && prisma generate && prisma db push --skip-generate",
    "db:cloud": "tsx scripts/set-db-provider.ts postgresql && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "prisma@6.19.3": true
  }
}
